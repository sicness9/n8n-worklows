  "nodes": [
    {
      "name": "Receive Confirm or Deny",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        240,
        400
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "calendar-confirm",
        "responseMode": "responseNode",
        "options": {
          "ignoreBots": true
        }
      },
      "id": "d0a9ea74-a104-4699-b5f4-6bc27e03c2fd",
      "webhookId": "9238bf95-1b2c-41d5-8e39-6b2416a113e5"
    },
    {
      "name": "Parse Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const query = $input.first().json.query;\nconst action = query.action || 'deny';\nlet event = null;\ntry {\n  event = JSON.parse(Buffer.from(query.data, 'base64url').toString('utf8'));\n} catch (e) {}\nif (!event || !event.start_datetime || !event.title) {\n  return [{ json: { action: 'deny', event: null } }];\n}\nreturn [{ json: { action, event } }];"
      },
      "id": "e0ae801e-cd86-4480-8ab8-b6eb3939ea26"
    },
    {
      "name": "Is Confirmed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        740,
        400
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.action }}",
              "rightValue": "confirm",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "17dfabc7-b515-4bfb-9166-0b4791c6f00a"
    },
    {
      "name": "Create Google Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "operation": "create",
        "calendar": {
          "__rl": true,
          "value": "nelson.torres@adquadrant.com",
          "mode": "id"
        },
        "start": "={{ $json.event.start_datetime }}",
        "end": "={{ $json.event.end_datetime }}",
        "additionalFields": {
          "summary": "={{ $json.event.title }}",
          "description": "={{ $json.event.description }}",
          "location": "={{ $json.event.location }}",
          "attendeesUi": {
            "attendeesValues": "={{ ($json.event.attendees || []).map(a => typeof a === 'string' ? {email: a} : {email: a.email || a}) }}"
          }
        },
        "resource": "event"
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "37dh7UZDNrM2RQ4L",
          "name": "Google Calendar account"
        }
      },
