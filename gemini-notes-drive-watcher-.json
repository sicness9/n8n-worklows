        "options": {}
      },
      "name": "Watch Gemini Notes Folder",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        240,
        304
      ],
      "id": "c62917a2-5bbd-415d-ad63-3213e3362261",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "HJ8ywOynfTLOofyY",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData(\"global\");\nconst processedIds = staticData.processedIds || [];\nconst results = [];\n\nfor (const item of $input.all()) {\n  const fileId = item.json.id;\n  const mimeType = item.json.mimeType || \"\";\n\n  if (mimeType !== \"application/vnd.google-apps.document\") continue;\n\n  if (!processedIds.includes(fileId)) {\n    processedIds.push(fileId);\n    results.push(item);\n  }\n}\n\nstaticData.processedIds = processedIds.length > 500 ? processedIds.slice(-500) : processedIds;\nreturn results;"
      },
      "name": "Dedup by File ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        304
      ],
      "id": "5d0e0900-d1d5-4ef5-b082-83a2e5213e58"
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "options": {
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "text/plain"
            }
          }
        }
      },
      "name": "Export Doc as Plain Text",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        720,
        304
      ],
      "id": "e2744fe5-281d-41ab-9502-e9e03b6b6800",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "HJ8ywOynfTLOofyY",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  let text = \"\";\n  try {\n    const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n    text = buffer.toString('utf-8');\n  } catch (e) {\n    if (item.binary && item.binary.data && item.binary.data.data) {\n      text = Buffer.from(item.binary.data.data, 'base64').toString('utf-8');\n    }\n  }\n  results.push({\n    json: {\n      subject: item.json.name || \"Unknown Meeting\",\n      body: text,\n      from: \"gemini-notes@google.com\"\n    }\n  });\n}\nreturn results;"
      },
      "name": "Extract Text from Doc",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        304
      ],
      "id": "85252958-d94a-42c3-9878-24022db6976e"
