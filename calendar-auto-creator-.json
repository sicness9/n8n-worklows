    {
      "id": "ff8ac85b-475f-49f1-9cb9-22009212a11a",
      "name": "Parse Calendar Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const response = $input.first().json;\nlet parsed;\ntry {\n  const text = response.content[0].text;\n  parsed = JSON.parse(text);\n} catch (e) {\n  parsed = { intent_level: 'null', event: null, slack_confirmation_message: null, alternatives: [] };\n}\nreturn [{ json: parsed }];"
      }
    },
