    {
      "id": "ade681ea-9f0e-42ca-9cfc-84c8ebd48f1c",
      "name": "Build Calendar Draft Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $input.first().json.body || $input.first().json;\nconst promptLines = [\n  '# Calendar Event Drafter',\n  '',\n  'Extract calendar event details from the content below.',\n  '',\n  '## Step 1: Detect Intent Level',\n  '- explicit: Specific date + time stated (Tuesday May 7 at 2pm)',\n  '- proposed: Multiple options offered (Tuesday or Wednesday)',\n  '- soft: Vague scheduling intent, no time (sync soon, book some time)',\n  '  Only draft if high-signal: external client, AJ, or deadline mentioned',\n  '- null: Soft signal with no urgency -- return null, do not draft',\n  '',\n  '## Step 2: Extract Event Details',\n  '- title: Short meeting title, infer from topic if not stated',\n  '- start_datetime: ISO 8601, resolve relative dates using current_date',\n  '- end_datetime: Calculate from duration. Default: +30min for calls, +1h for meetings',\n  '- attendees: From participants + anyone mentioned',\n  '- location: Google Meet/Zoom link, address, or null',\n  '- description: One sentence on meeting purpose',\n  '',\n  '## Return JSON',\n  'Return ONLY valid JSON:',\n  '{\"intent_level\": \"explicit|proposed|soft|null\",',\n  '\"event\": {\"title\": \"str\", \"start_datetime\": \"ISO|null\",',\n  '\"end_datetime\": \"ISO|null\", \"attendees\": [], \"location\": \"str|null\",',\n  '\"description\": \"str\"},',\n  '\"slack_confirmation_message\": \"str\",',\n  '\"alternatives\": [\"str\"]}',\n  '',\n  'If intent_level is null:',\n  '{\"intent_level\": \"null\", \"event\": null, \"slack_confirmation_message\": null, \"alternatives\": []}'\n];\nconst systemPrompt = promptLines.join('\\n');\nvar content = input.content || input.body || input.email_body || '';\nvar participants = input.participants || input.attendees || [];\nvar sourceType = input.source_type || 'email';\nvar currentDate = new Date().toISOString().split('T')[0];\n\nreturn [{ json: {\n  model: 'claude-sonnet-4-6',\n  max_tokens: 1024,\n  system: systemPrompt,\n  messages: [{ role: 'user', content:\n    'Source Type: ' + sourceType + '\\nCurrent Date: ' + currentDate +\n    '\\nParticipants: ' + JSON.stringify(participants) +\n    '\\n\\nContent:\\n' + content\n  }]\n}}];"
      }
    },
