    {
      "id": "07e557d5-4bb4-430b-884d-dd78e25191f5",
      "name": "Build Classification Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const email = $input.first().json.body || $input.first().json;\nconst promptLines = [\n  '# Email Classifier',\n  '',\n  'Classify the email below. Apply the FIRST matching rule in priority order.',\n  '',\n  '### 1. TRANSCRIPT',\n  'Match if: sender domain is fireflies.ai/otter.ai/zoom.us/fathom.video/grain.com,',\n  'or sender contains notetaker@/transcript@/recording@,',\n  'or sender is meet-recordings-noreply@google.com,',\n  'or subject contains transcript/recording/meeting notes/meeting summary,',\n  'or body > 1500 chars AND subject mentions meeting/call/sync/standup/review/demo.',\n  'No additional extraction needed.',\n  '',\n  '### 2. NEWSLETTER',\n  'Match if: headers contain List-Unsubscribe, or sender is no-reply/noreply/newsletter/marketing,',\n  'or body contains unsubscribe/view in browser/email preferences.',\n  'Extract: {sender_name, sender_email, is_new_sender: boolean}',\n  '',\n  '### 3. SPAM',\n  'Match if: unknown sender + no existing relationship, phishing/lottery/prize language.',\n  'No extraction.',\n  '',\n  '### 4. SCHEDULING',\n  'Match if: explicit times mentioned, scheduling phrases, calendar/meeting links.',\n  'Extract: {proposed_times: [], attendees: [], topic, meeting_link}',\n  '',\n  '### 5. WAITING_FOR_REPLY',\n  'Match if: thread_context shows Nelson sent the last message and no reply yet.',\n  'Extract: {recipient_name, recipient_email, subject, sent_date, thread_id}',\n  '',\n  '### 6. ACTION_REQUIRED',\n  'Match if: directly addressed to Nelson with question/request requiring response.',\n  'Extract: {action_summary: one sentence of what Nelson must DO,',\n  'sender_name: first name, deadline: date or null,',\n  'urgency: high if from AJ/Vish/Hailey/Lindsay or deadline within 24h else normal}',\n  '',\n  '### 7. FYI',\n  'Everything else: informational, receipts, CC announcements, system notifications.',\n  'Extract: {subject, sender_name}',\n  '',\n  '## Return Format',\n  'Return ONLY valid JSON, no preamble:',\n  '{\"class\": \"CLASS_NAME\", \"data\": {class-specific fields}}'\n];\nconst systemPrompt = promptLines.join('\\n');\nreturn [{ json: {\n  model: 'claude-sonnet-4-6',\n  max_tokens: 1024,\n  system: systemPrompt,\n  messages: [{ role: 'user', content:\n    'From: ' + (email.from || '') + '\\nSubject: ' + (email.subject || '') +\n    '\\nBody: ' + (email.body || '') + '\\nThread Context: ' + (email.thread_context || 'None')\n  }]\n}}];"
      }
    },
