        }
      },
      "credentials": {
        "asanaApi": {
          "id": "8TkSLWQIQqZBfEWT",
          "name": "Asana - API Token"
        }
      }
    },
    {
      "id": "a5fe7aa0-baa9-41e8-ae86-679bfe91fd0e",
      "name": "Build Brief Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "var today = new Date();\nvar dateStr = today.toISOString().split('T')[0];\nvar dayName = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][today.getDay()];\n\nvar tasks = $input.all().map(function(item) { return item.json; });\nvar asanaData = {\n  tasks_due_today: tasks.filter(function(t) { return t.due_on === dateStr; }).map(function(t) { return t.name; }),\n  overdue: tasks.filter(function(t) { return t.due_on && t.due_on < dateStr; }).map(function(t) { return t.name; }),\n  upcoming: tasks.filter(function(t) { return t.due_on && t.due_on > dateStr; }).slice(0, 10).map(function(t) { return t.name + ' (due: ' + t.due_on + ')'; }),\n  no_due_date: tasks.filter(function(t) { return !t.due_on; }).map(function(t) { return t.name; })\n};\nvar slackData = { unread_dms: [], mentions: [], note: 'Slack data not yet connected' };\nvar gmailData = { action_required: [], unread_count: 0, note: 'Gmail data not yet connected' };\n\nvar systemPrompt = [\n  '# Morning Briefing',\n  '',\n  'Generate a concise morning briefing for Nelson Torres at AdQuadrant.',\n  'Today is ' + dayName + ', ' + dateStr + '.',\n  '',\n  '## Data Sources',\n  '',\n  '### Asana Tasks',\n  JSON.stringify(asanaData),\n  '',\n  '### Slack (last 24h)',\n  JSON.stringify(slackData),\n  '',\n  '### Gmail',\n  JSON.stringify(gmailData),\n  '',\n  '## Output Format',\n  '',\n  '### Needs Action Today',\n  'Ranked by urgency + effort. Include source and brief context.',\n  '',\n  '### On Your Radar',\n  'Due soon, waiting on others, FYI threads worth knowing.',\n  '',\n  '### Inbox Summary',\n  'Slack + email items condensed. Paraphrase, never verbatim.',\n  '',\n  '## Rules',\n  '- Keep under 40 lines total',\n  '- Do not list completed tasks',\n  '- If nothing is urgent, say so',\n  '- Cross-reference Slack/email threads connected to Asana tasks'\n].join('\\n');\n\nreturn [{ json: {\n  model: 'claude-sonnet-4-6',\n  max_tokens: 2048,\n  system: systemPrompt,\n  messages: [{ role: 'user', content:\n    'Generate the morning briefing for ' + dayName + ' ' + dateStr + '.'\n  }]\n}}];"
      }
    },
    {
      "id": "73174036-b27e-4ed8-9fa9-86fc1f980c34",
      "name": "Generate Brief via Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1060,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "qjdLurgn1OANVO3L",
          "name": "Header Auth account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "1ebabddc-269e-43ab-bd46-efeec15fc9fa",
      "name": "Parse Brief Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const response = $input.first().json;\nlet briefText;\ntry {\n  briefText = response.content[0].text;\n} catch (e) {\n  briefText = 'Error generating brief: ' + e.message;\n}\nreturn [{ json: { brief: briefText, generated_at: new Date().toISOString() } }];"
      }
    },
    {
      "id": "e961011c-a84a-4407-8c07-e54d84f3b5fc",
