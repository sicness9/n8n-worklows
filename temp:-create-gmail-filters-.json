        "jsCode": "const OPS_LABEL = 'Label_2356661191061945189';\n\nconst filters = [\n  {\n    criteria: { from: 'no-reply@asana.com', subject: 'unread notifications' },\n    action: { removeLabelIds: ['INBOX'] }\n  },\n  {\n    criteria: { from: 'no-reply@asana.com', query: 'subject:(digest OR summary) -subject:assigned -subject:task' },\n    action: { removeLabelIds: ['INBOX'] }\n  },\n  {\n    criteria: { from: 'goat-scheduler@everquote.com' },\n    action: { removeLabelIds: ['INBOX'], addLabelIds: [OPS_LABEL] }\n  },\n  {\n    criteria: { from: 'delty-reporting@qw-corp.com' },\n    action: { removeLabelIds: ['INBOX'], addLabelIds: [OPS_LABEL] }\n  }\n];\n\nreturn filters.map(f => ({ json: f }));"
      },
